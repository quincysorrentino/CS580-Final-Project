#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/ThreadMetalPlate.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/CorrugatedMetal.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/GlossyPaint.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/factory/conveyors/protos/ConveyorBelt.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/factory/containers/protos/PlasticCrate.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/universal_robots/protos/UR5e.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/devices/robotiq/protos/RobotiqEPickGripper.proto"
IMPORTABLE EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/drinks/protos/WaterBottle.proto"

WorldInfo {
  info [
    "UR5e + Robotiq EPick vacuum gripper sorting parts off a conveyor belt."
  ]
  title "UR5e Conveyor Sorting"
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      coulombFriction [
        0.8
      ]
      bounce 0.05
    }
  ]
}
Viewpoint {
  orientation 0.24530228254835873 0.22190206480831962 -0.9437087812510645 1.7468
  position -0.35 3.2 2.35
  exposure 1.4
}
TexturedBackground {
  texture "factory"
}
TexturedBackgroundLight {
  texture "factory"
}
Floor {
  size 8 6
  appearance ThreadMetalPlate {
  }
}
DEF CONVEYOR ConveyorBelt {
  size 4 0.5 0.6
  appearance CorrugatedMetal {
    textureTransform TextureTransform {
      scale 4 1
    }
  }
  borderHeight 0.03
  speed 0.1
}
DEF PEDESTAL Solid {
  translation 0 -0.55 0.3
  children [
    Shape {
      appearance GlossyPaint {
        baseColor 0.25 0.27 0.3
      }
      geometry DEF PEDESTAL_BOX Box {
        size 0.3 0.3 0.6
      }
    }
  ]
  name "pedestal"
  boundingObject USE PEDESTAL_BOX
}
DEF UR5E UR5e {
  translation 0 -0.55 0.6
  controller "<none>"
  selfCollision FALSE
  toolSlot [
    RobotiqEPickGripper {
      rotation 1 0 0 -1.5708
    }
    Receiver {
      channel 1
    }
  ]
}
DEF BIN_RED PlasticCrate {
  translation -0.4 -1.05 0
  name "bin red"
  size 0.3 0.3 0.25
  color 0.85 0.15 0.15
}
DEF BIN_GREEN PlasticCrate {
  translation 0 -1.05 0
  name "bin green"
  size 0.3 0.3 0.25
  color 0.15 0.7 0.2
}
DEF BIN_BLUE PlasticCrate {
  translation 0.4 -1.05 0
  name "bin blue"
  size 0.3 0.3 0.25
  color 0.15 0.3 0.85
}
DEF OVERHEAD_CAMERA Robot {
  translation -1 0 1.6
  children [
    DEF CAM_POLE Pose {
      translation 0 0.4 -0.8
      children [
        Shape {
          appearance DEF POLE_PAINT GlossyPaint {
            baseColor 0.3 0.3 0.3
          }
          geometry Cylinder {
            height 1.6
            radius 0.02
          }
        }
      ]
    }
    DEF CAM_ARM Pose {
      translation 0 0.2 0.03
      rotation 1 0 0 1.5708
      children [
        Shape {
          appearance USE POLE_PAINT
          geometry Cylinder {
            height 0.4
            radius 0.015
          }
        }
      ]
    }
    Camera {
      rotation 0 1 0 1.5708
      children [
        Shape {
          appearance GlossyPaint {
            baseColor 0.1 0.1 0.1
          }
          geometry Box {
            size 0.06 0.05 0.05
          }
        }
      ]
      fieldOfView 0.9
      width 640
      height 480
      recognition Recognition {
        frameColor 1 1 0
      }
    }
    Emitter {
      channel 1
    }
  ]
  name "overhead camera"
  controller "overhead_vision"
}
# Uses the parts below as templates: on Play it copies and removes them, then
# spawns random copies (duplicates allowed) at the start of the belt.
DEF PART_SPAWNER Robot {
  name "part spawner"
  controller "part_spawner"
  supervisor TRUE
}
# Part templates (camera sees x -1.35..-0.65 on the belt). Their x/y here only
# matter in the editor; part_spawner keeps their z and rotation.
# Bottle: PROTO origin is at its base, axis along +Z; rotated to lie along +X,
# so its center is 0.15 m ahead of the origin, at (-0.80, 0.15).
DEF PART_BOTTLE WaterBottle {
  translation -0.95 0.15 0.65
  rotation 0 1 0 1.5708
}
# Clock, 16 cm across, lying face up. Webots' own Clock PROTO is a 33 cm wall
# clock that cannot be scaled, so this one is built from a dark rim disc, a thin
# disc with the same clock_face.jpg texture on top, and two black hands.
# Origin is at the clock's center (rim is 2 cm thick).
DEF PART_CLOCK Solid {
  translation -0.85 -0.08 0.612
  children [
    # rim / body
    Shape {
      appearance PBRAppearance {
        baseColor 0.15 0.15 0.15
        roughness 0.4
        metalness 0
      }
      geometry Cylinder {
        height 0.02
        radius 0.08
      }
    }
    # face (texture on the top cap only)
    Pose {
      translation 0 0 0.0105
      children [
        Shape {
          appearance PBRAppearance {
            baseColorMap ImageTexture {
              url [
                "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/school_furniture/protos/textures/clock_face.jpg"
              ]
            }
            roughness 0.5
            metalness 0
          }
          geometry Cylinder {
            height 0.001
            radius 0.074
            bottom FALSE
            side FALSE
          }
        }
      ]
    }
    # hour hand
    Pose {
      translation 0.018 0 0.0118
      children [
        Shape {
          appearance DEF CLOCK_HAND PBRAppearance {
            baseColor 0 0 0
            roughness 0.5
            metalness 0
          }
          geometry Box {
            size 0.036 0.006 0.0015
          }
        }
      ]
    }
    # minute hand
    Pose {
      translation 0 -0.028 0.0118
      children [
        Shape {
          appearance USE CLOCK_HAND
          geometry Box {
            size 0.004 0.056 0.0015
          }
        }
      ]
    }
  ]
  name "clock"
  boundingObject Cylinder {
    height 0.02
    radius 0.08
  }
  physics Physics {
    density -1
    mass 0.3
  }
}
# Cat lying on its side, head toward +X, feet toward +Y.
# Uses the 3D mesh and texture from Webots' Cat PROTO, but in our own Solid so
# the only collision shape is one flat box that exactly encloses the mesh
# (the PROTO's own collision shapes made it rest tilted).
# Transform: scale 0.4 (~22 cm long), rotate 90 deg about X to lay it on its
# side, then shift so the mesh is centered on the Solid's origin.
# Lying mesh size (measured from cat.obj): 0.219 x 0.136 x 0.045 m.
# Origin sits half the thickness (2.26 cm) above the belt.
DEF PART_CAT Solid {
  translation -1.17 0.05 0.6236
  children [
    Transform {
      translation 0.0294 0.0677 0
      rotation 1 0 0 1.5708
      scale 0.4 0.4 0.4
      children [
        Shape {
          appearance PBRAppearance {
            baseColorMap ImageTexture {
              url [
                "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/animals/protos/cat/textures/cat_basecolor.jpg"
              ]
            }
            roughness 1
            metalness 0
          }
          geometry Mesh {
            url [
              "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/animals/protos/cat/meshes/cat.obj"
            ]
          }
        }
      ]
    }
  ]
  name "cat"
  boundingObject Box {
    size 0.22 0.136 0.0452
  }
  physics Physics {
    density -1
    mass 0.3
  }
}
